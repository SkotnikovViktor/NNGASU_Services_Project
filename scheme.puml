@startuml
skinparam linetype ortho
allowmixing

skinparam nodesep 24
skinparam ranksep 10
skinparam padding 4

class user {
+ name
+ status / class
- login
- password
}

' === BACKEND ===
package backend <<Folder>> {
  class NGinx {}

  package authentification {}
  package way {}
  package schedule {}
  package working_off {}

  package database {
    database postgresql {
    }

    database redis {
    }
  }
}

' === FRONTEND ===
package frontend <<Folder>> {
 package pages {
  class html {
    registration_menu
    enter_menu
    main_menu
  }
 }

 package styles {
  class css {
    dark_theme
    light_theme
  }
 }

 package scripts {
  class js {
    router
  }
 }

 class index_html {}
}

' === DEPENDENCIES ===
user -left--> index_html

index_html --> pages
index_html --> styles
index_html --> scripts

css -right..> html
html <..> js

js --> NGinx

NGinx --> authentification
NGinx --> schedule

schedule <-- postgresql
working_off <--> postgresql
authentification <--> postgresql
authentification <--> redis

authentification --> working_off
authentification ..> schedule
schedule --> way

' === HIDDEN ===
redis -[hidden]right- postgresql

pages -[hidden]left- styles

NGinx -[hidden]- authentification

working_off -[hidden]right- authentification
authentification -[hidden]right- schedule
schedule -[hidden]right- way

' === NOTES ===
@enduml
